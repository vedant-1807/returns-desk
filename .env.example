# Copy to .env for local development. Every value here is a local-only default.

# "local" allows the development secrets below. Set anything else (for example
# "production") and the app refuses to start until both secrets are replaced.
RD_ENVIRONMENT=local

# Admin connection: runs migrations and seeds. Never used by the API at request time.
RD_ADMIN_DSN=postgresql://postgres:postgres@localhost:54329/returns_desk

# The API's request-time role. Subject to row-level security.
RD_APP_DSN=postgresql://rd_app:rd_app_local@localhost:54329/returns_desk

# Admin jobs only (refund execution and reconciliation). Bypasses row-level security.
RD_SERVICE_DSN=postgresql://rd_service:rd_service_local@localhost:54329/returns_desk

# The sandbox payment processor keeps its own records under its own role.
RD_PROCESSOR_DSN=postgresql://rd_processor:rd_processor_local@localhost:54329/returns_desk

# Signs and verifies access tokens (HS256). Use a long random value outside local dev.
RD_JWT_SECRET=local-dev-secret-change-me-0123456789abcdef

# Shared secret for POST /internal/reconcile (called by pg_cron in production).
RD_INTERNAL_TOKEN=local-internal-token-change-me

# Workflow checkpoints (LangGraph) use their own role, which can reach nothing else.
RD_WORKFLOW_DSN=postgresql://rd_workflow:rd_workflow_local@localhost:54329/returns_desk

# --- Models -----------------------------------------------------------------------------
# Routes, tried in order; a rate limit or timeout on one fails over to the next.
#   keyword     no model: a keyword stand-in. The default, so a fresh checkout just runs.
#   ollama      local models, free. Needs `ollama pull llama3.1:8b`.
#   groq        free plan. Needs RD_GROQ_API_KEY (no card needed to make one).
#   openrouter  paid, a few cents. Needs RD_OPENROUTER_API_KEY and bought credits.
# Examples: RD_MODEL_ROUTES=ollama    or    RD_MODEL_ROUTES=groq,ollama (free, with a backup)
RD_MODEL_ROUTES=keyword
# RD_OLLAMA_BASE_URL=http://localhost:11434/v1
# RD_GROQ_API_KEY=
# RD_OPENROUTER_API_KEY=
# Local models are slower than hosted ones; give them more than the default 10 seconds.
# RD_MODEL_DEADLINE_SECONDS=60
# A rate-limited route can be waited for instead of failing over: the longest wait in
# seconds, 0 for never. Leave it at 0 for the app. Evals always wait up to 60 seconds, so
# a free plan's per-minute limit slows a run down instead of breaking it.
# RD_MODEL_RATE_LIMIT_WAIT_SECONDS=0

# --- Embeddings (policy search) -----------------------------------------------------------
#   hash        no model: hashed words. The default.
#   ollama      nomic-embed-text locally. Needs `ollama pull nomic-embed-text`.
#   openrouter  baai/bge-base-en-v1.5. Needs RD_OPENROUTER_API_KEY.
# Re-run `returns-desk seed` after changing this: stored vectors belong to one embedder.
RD_EMBEDDER=hash

# --- The two screens ------------------------------------------------------------------------
# Browser origins allowed to call the API.
RD_CORS_ORIGINS=http://localhost:3000
